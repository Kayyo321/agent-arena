{
  "schemaVersion": 1,
  "id": "code-review",
  "name": "Cross-provider implementation and review",
  "description": "A coordinator hands implementation to one agent, a cross-provider review team examines the change and can send it back for revision, and a maintainer is on call for unresolved results.",
  "headAgent": "orchestrator",
  "agents": [
    {
      "id": "orchestrator",
      "profile": ".agents/code-review/orchestrator.agent.json",
      "activation": "path",
      "level": 0,
      "runtime": {
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "reasoningEffort": "high"
      }
    },
    {
      "id": "implementer",
      "profile": ".agents/code-review/implementer.agent.json",
      "activation": "path",
      "level": 1,
      "runtime": {
        "provider": "claude-code",
        "model": "sonnet",
        "reasoningEffort": "high"
      }
    },
    {
      "id": "reviewer",
      "profile": ".agents/code-review/reviewer.agent.json",
      "activation": "path",
      "level": 2,
      "runtime": {
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "reasoningEffort": "high"
      }
    },
    {
      "id": "security-reviewer",
      "profile": ".agents/code-review/security-reviewer.agent.json",
      "activation": "path",
      "level": 2,
      "runtime": {
        "provider": "claude-code",
        "model": "sonnet",
        "reasoningEffort": "high"
      }
    },
    {
      "id": "maintainer-on-call",
      "profile": ".agents/code-review/maintainer-on-call.agent.json",
      "activation": "on-call",
      "runtime": {
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "reasoningEffort": "high"
      }
    }
  ],
  "teams": [
    {
      "id": "release-review",
      "name": "Release review team",
      "members": ["reviewer", "security-reviewer"],
      "facilitator": "reviewer",
      "consensus": {
        "mode": "unanimous-deliberation",
        "maxRounds": 2
      },
      "outputContract": {
        "format": "arena.team-verdict.v1",
        "verdicts": ["Approved", "ChangesRequested", "Deny", "NeedsMoreInformation"]
      }
    }
  ],
  "decisionRouters": [
    {
      "id": "review-gate",
      "name": "Release review gate",
      "inputKind": "team-result",
      "payloadPointer": "/verdict",
      "routes": [
        { "id": "changes-requested", "equals": "ChangesRequested", "to": "implementer", "loop": true, "maxIterations": 2 }
      ],
      "fallback": { "action": "stop" }
    }
  ],
  "onCall": [
    {
      "agentId": "maintainer-on-call",
      "maxInvocationsPerRun": 1,
      "triggers": [
        { "type": "event", "event": "team.no-consensus", "teamId": "release-review" },
        { "type": "event", "event": "validation.failed" },
        { "type": "manual" }
      ]
    }
  ],
  "relationships": [
    { "type": "delegates", "from": "orchestrator", "to": "implementer" },
    { "type": "delegates", "from": "implementer", "to": "release-review" },
    { "type": "delegates", "from": "release-review", "to": "review-gate" },
    { "type": "communicates", "from": "orchestrator", "to": "implementer", "direction": "two-way" }
  ],
  "settings": {
    "maxConcurrentAgents": 4,
    "workspace": {
      "writeIsolation": "git-worktree-per-task"
    },
    "integration": {
      "policy": "human-review"
    },
    "audit": {
      "retention": "full-local"
    }
  }
}
