{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Arena profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "role", "objective", "instructions", "capabilities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 64
    },
    "name": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "objective": { "type": "string", "minLength": 1 },
    "instructions": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["read", "write", "run_commands", "research", "review"]
      }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "outcomes"],
      "properties": {
        "format": { "const": "arena.review-verdict.v1" },
        "outcomes": {
          "const": ["Approved", "ChangesRequested", "Deny", "NeedsMoreInformation"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "review" } }, "required": ["role"] },
      "then": { "required": ["reviewContract"] }
    }
  ]
}
