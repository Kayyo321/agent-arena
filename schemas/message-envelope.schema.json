{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Arena protocol message envelope",
  "type": "object",
  "required": ["protocolVersion", "messageId", "runId", "kind", "from", "to", "createdAt", "correlationId", "attemptId", "replyTo", "payload", "providerContext"],
  "properties": {
    "protocolVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "messageId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["task", "question", "message", "result", "review-result", "team-result", "fanout-result", "coworker-request", "context-proposal", "context-result", "error", "cancel"] },
    "from": { "$ref": "#/$defs/actor" },
    "to": { "$ref": "#/$defs/actor" },
    "createdAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "replyTo": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "providerContext": {
      "type": "object",
      "description": "Opaque provider-specific values. Forward unchanged unless the target adapter explicitly handles them.",
      "properties": {
        "model": { "type": "string" },
        "reasoningEffort": { "type": ["string", "null"] },
        "options": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "invocation": {
      "description": "Optional routing metadata for team-member, on-call and fan-out task deliveries.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "teamId"],
          "properties": {
            "mode": { "const": "team-member" },
            "teamId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "trigger", "triggerEventId", "sourceId"],
          "properties": {
            "mode": { "const": "on-call" },
            "trigger": { "enum": ["manual", "team.no-consensus", "agent.failed", "validation.failed", "change.touches-paths"] },
            "triggerEventId": { "type": "string", "minLength": 1 },
            "sourceId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "fanOutId"],
          "properties": {
            "mode": { "const": "fanout-planner" },
            "fanOutId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "fanOutId", "index", "of"],
          "properties": {
            "mode": { "const": "fanout-child" },
            "fanOutId": { "type": "string", "minLength": 1 },
            "index": { "type": "integer", "minimum": 1 },
            "of": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "task" } }, "required": ["kind"] },
      "else": { "not": { "required": ["invocation"] } }
    },
    {
      "if": { "required": ["invocation"] },
      "then": { "properties": { "protocolVersion": { "pattern": "^1\\.(?:[1-9][0-9]*)$" } } }
    },
    {
      "if": { "properties": { "invocation": { "properties": { "mode": { "enum": ["fanout-planner", "fanout-child"] } }, "required": ["mode"] } }, "required": ["invocation"] },
      "then": { "properties": { "protocolVersion": { "pattern": "^1\\.(?:[3-9]|[1-9][0-9]+)$" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "coworker-request" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["workflowId", "role", "objective", "runtime", "capabilities", "workspaceMode", "files", "reason"],
            "properties": {
              "workflowId": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "objective": { "type": "string", "minLength": 1 },
              "runtime": {
                "type": "object",
                "required": ["provider", "model", "reasoningEffort"],
                "properties": {
                  "provider": { "type": "string", "minLength": 1 },
                  "model": { "type": "string", "minLength": 1 },
                  "reasoningEffort": { "type": ["string", "null"] },
                  "options": { "type": "object", "additionalProperties": true }
                },
                "additionalProperties": false
              },
              "capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["read", "write", "run_commands", "research", "review"] }
              },
              "workspaceMode": { "enum": ["read-only", "write"] },
              "files": { "type": "array", "items": { "type": "string" } },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "enum": ["context-proposal", "context-result"] } }, "required": ["kind"] },
      "then": { "properties": { "protocolVersion": { "pattern": "^1\\.(?:[2-9]|[1-9][0-9]+)$" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "context-proposal" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["workflowId", "operation", "entryId"],
            "properties": {
              "workflowId": { "type": "string", "minLength": 1 },
              "operation": { "enum": ["add", "revise", "archive"] },
              "entryId": { "type": ["string", "null"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 160 },
              "content": { "type": "string", "minLength": 1 },
              "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "confidence": { "enum": ["verified", "inferred", "unverified"] },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "reference"],
                  "properties": {
                    "kind": { "enum": ["file", "url", "decision", "message", "other"] },
                    "reference": { "type": "string", "minLength": 1 },
                    "note": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "reason": { "type": "string" }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": { "properties": { "operation": { "const": "add" } }, "required": ["operation"] },
                "then": { "required": ["title", "content", "tags", "confidence", "evidence"], "properties": { "entryId": { "type": "null" } } }
              },
              {
                "if": { "properties": { "operation": { "const": "revise" } }, "required": ["operation"] },
                "then": { "required": ["entryId", "title", "content", "tags", "confidence", "evidence"], "properties": { "entryId": { "type": "string", "minLength": 1 } } }
              },
              {
                "if": { "properties": { "operation": { "const": "archive" } }, "required": ["operation"] },
                "then": { "required": ["entryId", "reason"], "properties": { "entryId": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 } } }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "context-result" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["format", "outcome", "entryId"],
            "properties": {
              "format": { "const": "arena.context-result.v1" },
              "outcome": { "enum": ["accepted", "needs-user", "refused", "not-found"] },
              "entryId": { "type": ["string", "null"] },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "review-result" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["format", "outcome", "summary", "rationale", "findings", "openQuestions", "nextAction"],
            "properties": {
              "format": { "const": "arena.review-verdict.v1" },
              "outcome": { "enum": ["Approved", "ChangesRequested", "Deny", "NeedsMoreInformation"] },
              "summary": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["severity", "file", "line", "evidence", "recommendation"],
                  "properties": {
                    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
                    "file": { "type": "string", "minLength": 1 },
                    "line": { "type": ["integer", "null"], "minimum": 1 },
                    "evidence": { "type": "string", "minLength": 1 },
                    "recommendation": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "openQuestions": { "type": "array", "items": { "type": "string" } },
              "validation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["command", "outcome"],
                  "properties": {
                    "command": { "type": "string" },
                    "outcome": { "type": "string" },
                    "details": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              },
              "nextAction": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "team-result" } }, "required": ["kind"] },
      "then": { "properties": { "protocolVersion": { "pattern": "^1\\.(?:[1-9][0-9]*)$" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "review-result" } }, "required": ["kind"] },
      "then": { "properties": { "protocolVersion": { "pattern": "^1\\.(?:[1-9][0-9]*)$" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "fanout-result" } }, "required": ["kind"] },
      "then": { "properties": { "protocolVersion": { "pattern": "^1\\.(?:[3-9]|[1-9][0-9]+)$" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "coworker-request" } }, "required": ["kind"] },
      "then": { "properties": { "protocolVersion": { "pattern": "^1\\.(?:[1-9][0-9]*)$" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "task" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["objective", "acceptanceCriteria", "context", "constraints", "files", "expectedOutput", "workspace"],
            "properties": {
              "objective": { "type": "string", "minLength": 1 },
              "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
              "context": { "type": "array", "items": { "type": "string" } },
              "constraints": { "type": "array", "items": { "type": "string" } },
              "attachments": {
                "description": "Optional user-supplied, run-scoped file snapshots. Binary contents stay outside the envelope.",
                "type": "array", "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["name", "mediaType", "size", "sha256", "file"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "mediaType": { "type": "string", "minLength": 1 },
                    "size": { "type": "integer", "minimum": 0, "maximum": 10485760 },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "file": { "type": "string", "pattern": "^attachments/[a-f0-9]{64}/[^/]+$" }
                  },
                  "additionalProperties": false
                }
              },
              "files": { "type": "array", "items": { "type": "string" } },
              "expectedOutput": { "type": "array", "items": { "type": "string" } },
              "workspace": { "$ref": "#/$defs/workspace" },
              "deadline": { "type": ["string", "null"], "format": "date-time" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "question" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["question", "decisionNeeded"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "decisionNeeded": { "type": "string", "minLength": 1 },
              "context": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "message" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["text"],
            "properties": { "text": { "type": "string", "minLength": 1 } },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "result" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["summary", "changedFiles", "validation", "limitations", "nextAction"],
            "properties": {
              "summary": { "type": "string" },
              "changedFiles": { "type": "array", "items": { "type": "string" } },
              "commit": { "type": ["string", "null"] },
              "checkpoint": { "type": ["string", "null"] },
              "validation": { "type": "array", "items": { "type": "object", "required": ["command", "outcome"], "properties": { "command": { "type": "string" }, "outcome": { "type": "string" }, "details": { "type": "string" } }, "additionalProperties": true } },
              "limitations": { "type": "array", "items": { "type": "string" } },
              "nextAction": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "team-result" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["teamId", "format", "outcome", "verdict", "summary", "rationale", "evidence", "memberPositions", "dissent", "rounds", "nextAction"],
            "properties": {
              "teamId": { "type": "string", "minLength": 1 },
              "format": { "const": "arena.team-verdict.v1" },
              "outcome": { "enum": ["consensus", "no-consensus"] },
              "verdict": { "type": ["string", "null"] },
              "summary": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string" },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "memberPositions": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["agentId", "verdict", "status", "summary", "evidence"],
                  "properties": {
                    "agentId": { "type": "string", "minLength": 1 },
                    "verdict": { "type": ["string", "null"] },
                    "status": { "enum": ["affirmed", "disagreed", "unavailable"] },
                    "summary": { "type": "string" },
                    "evidence": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": false
                }
              },
              "dissent": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["agentId", "position", "reason"],
                  "properties": {
                    "agentId": { "type": "string", "minLength": 1 },
                    "position": { "type": ["string", "null"] },
                    "reason": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "rounds": { "type": "integer", "minimum": 0 },
              "nextAction": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true,
            "allOf": [
              {
                "if": { "properties": { "outcome": { "const": "consensus" } }, "required": ["outcome"] },
                "then": {
                  "properties": { "verdict": { "type": "string", "minLength": 1 }, "dissent": { "maxItems": 0 } }
                }
              },
              {
                "if": { "properties": { "outcome": { "const": "no-consensus" } }, "required": ["outcome"] },
                "then": {
                  "properties": { "verdict": { "type": "null" }, "dissent": { "minItems": 1 } }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "fanout-result" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["format", "fanOutId", "summary", "planned", "results", "dropped"],
            "properties": {
              "format": { "const": "arena.fanout-result.v1" },
              "fanOutId": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "planned": { "type": "integer", "minimum": 0 },
              "results": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": ["childId", "item", "status", "messageId", "changeIds", "summary"],
                  "properties": {
                    "childId": { "type": "string", "minLength": 1 },
                    "item": { "$ref": "#/$defs/fanOutItem" },
                    "status": { "enum": ["succeeded", "failed"] },
                    "messageId": { "type": ["string", "null"] },
                    "changeIds": { "type": "array", "items": { "type": "string" } },
                    "summary": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "dropped": { "type": "array", "items": { "$ref": "#/$defs/fanOutItem" } }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "error" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" },
              "details": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "cancel" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["reason"],
            "properties": { "reason": { "type": "string" } },
            "additionalProperties": true
          }
        }
      }
    }
  ],
  "$defs": {
    "fanOutItem": {
      "type": "object",
      "required": ["title", "instructions"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "instructions": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["agentId", "provider"],
      "properties": {
        "agentId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["baseCommit", "mode"],
      "properties": {
        "baseCommit": { "type": ["string", "null"] },
        "mode": { "enum": ["read-only", "write"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
